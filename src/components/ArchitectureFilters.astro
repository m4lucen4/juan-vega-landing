---
const types = [
  ['todos', 'Todos'], ['residencial', 'Residencial'],
  ['rehabilitacion', 'Rehabilitación'], ['cultural', 'Cultural'],
];
const statuses = [
  ['todos', 'Todos'], ['construido', 'Construido'],
  ['en-progreso', 'En progreso'], ['proyecto', 'Proyecto'],
];
---
<div class="architecture-toolbar">
  <div class="architecture-filter">
    <label class="architecture-filter__label" for="architecture-type">Tipo</label>
    <select id="architecture-type" data-filter="type">
      {types.map(([value, label]) => <option value={value}>{label}</option>)}
    </select>
  </div>
  <div class="architecture-filter">
    <label class="architecture-filter__label" for="architecture-status">Estado</label>
    <select id="architecture-status" data-filter="status">
      {statuses.map(([value, label]) => <option value={value}>{label}</option>)}
    </select>
  </div>
  <div class="architecture-view" role="group" aria-label="Vista de proyectos">
    <button type="button" data-view="grid" aria-pressed="true">Grid</button>
    <button type="button" data-view="list" aria-pressed="false">Lista</button>
  </div>
</div>
